{
  "manifest_version": 3,
  "name": "Mermaid Render",
  "version": "0.1.1",
  "description": "Adds a toggle to Mermaid code blocks on web pages to show the diagram they describe.",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["background.js"], "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }],
  "browser_specific_settings": {
    "gecko": { "id": "mermaid-render@imaginaryba", "strict_min_version": "128.0", "data_collection_permissions": { "required": ["none"] } }
  }
}
